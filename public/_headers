# Cloudflare Workers 静态资源的响应头（这个文件本身不会被当页面发出去）。
# 资源带 ?v=时间戳，所以可以长缓存；HTML 仍然每次回源校验。
# 多条规则同时命中时头会叠加（同名头用逗号拼起来），所以先写 /* 通用规则，
# 再在具体路径里用「! Cache-Control」摘掉通用值后重设。
# CSP：唯一外部脚本是 Cloudflare 自动注入的 Insights beacon；style-src 保留 'unsafe-inline'
# 是因为 render.js 里还有 style="…" 内联属性。script-src 里的 'sha256-…' 是首页 JSON-LD 的哈希，
# 由 tools/build_pages.mjs 每次构建自动维护（改 data.js 的 me.* 后会变），不要手改。

/*
  Cache-Control: public, max-age=0, must-revalidate
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), camera=(), microphone=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' https://static.cloudflareinsights.com 'sha256-oZoMV+TnI0QswRujt1IiegYeqnBRGJca0BZowPrS9y8='; connect-src 'self' https://cloudflareinsights.com; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'

# /kol KOL 工作台：密码页，禁止搜索引擎收录
/kol
  X-Robots-Tag: noindex, nofollow

# /desk 我的工作台：密码页，禁止搜索引擎收录（主站导航有入口，但不进 sitemap）
# v3 素材库在浏览器里把本机图片转成 blob: 地址显示（图片不上传），所以这一页的 CSP 多放行 img-src blob:；
# 这一页没有内联脚本，不需要首页 JSON-LD 的 sha256（build_pages.mjs 只维护上面 /* 那一行）
/desk
  X-Robots-Tag: noindex, nofollow
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' https://static.cloudflareinsights.com; connect-src 'self' https://cloudflareinsights.com; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'

# /desk-demo 我的工作台演示版：不用登录，数据全是虚构的、只在访客自己的浏览器里（demo.js 模拟接口）。
# 和 /desk 同一套页面代码，所以 CSP 一样（素材库演示图同样走 blob:）；不收录，从作品集 / 案例页 /workbench 的链接进来
/desk-demo
  X-Robots-Tag: noindex, nofollow
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' https://static.cloudflareinsights.com; connect-src 'self' https://cloudflareinsights.com; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'

/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/og.png
  ! Cache-Control
  Cache-Control: public, max-age=604800
/favicon.svg
  ! Cache-Control
  Cache-Control: public, max-age=604800
/favicon.ico
  ! Cache-Control
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  ! Cache-Control
  Cache-Control: public, max-age=604800
